{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nostalgia Orbit",
  "version": "0.1.0",
  "identifier": "tv.nostalgiaorbit.app",
  "build": { "frontendDist": "../../../dist/bundle" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "Nostalgia Orbit", "width": 1280, "height": 720, "resizable": true, "fullscreen": false, "useHttpsScheme": true, "backgroundColor": "#000000" }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": { "webviewInstallMode": { "type": "embedBootstrapper" } }
  }
}
